# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings -> Environment Variables, then redeploy. Never commit real values.

# --- Supabase: where messages are stored ---------------------------------------
# Project Settings -> API: "Project URL" and the anon / publishable key (NOT the service_role key).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- Telegram: instant phone notification --------------------------------------
# 1. Message @BotFather -> /newbot -> copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- reCAPTCHA v3: stops bots (https://www.google.com/recaptcha/admin) -----------
# Create a key of type "Score based (v3)" and add your domains (gdyportfolio.vercel.app, and localhost for testing).
# The SITE key is public (it is sent to the browser) and is read when the page is built,
# so set it in Vercel BEFORE you deploy/redeploy.
PUBLIC_RECAPTCHA_SITE_KEY=YOUR-RECAPTCHA-SITE-KEY
RECAPTCHA_SECRET_KEY=YOUR-RECAPTCHA-SECRET-KEY
# Messages scoring below this are refused (1.0 = human, 0.0 = bot). 0.5 is Google's default.
# RECAPTCHA_MIN_SCORE=0.5

# --- Optional -----------------------------------------------------------------
# Last-resort fallback if Supabase and Telegram both fail. Defaults to the original
# Google Apps Script in data/site.ts.
# CONTACT_FALLBACK_URL=
